model RestockSession {
  id             String   @id @default(uuid())
  shopId         String
  vendorId       String?
  transportCost  Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  paid           Decimal  @default(0) @db.Decimal(12, 2)
  isOpeningStock Boolean  @default(false)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop   Shop          @relation(fields: [shopId], references: [id])
  vendor Vendor?       @relation(fields: [vendorId], references: [id])
  items  RestockItem[]

  @@index([shopId, createdAt])
  @@index([vendorId])
  @@map("restock_sessions")
}

model RestockItem {
  id             String   @id @default(uuid())
  sessionId      String
  productId      String
  quantity       Int
  buyPrice       Decimal  @db.Decimal(12, 4)
  landedUnitCost Decimal  @db.Decimal(12, 4)
  createdAt      DateTime @default(now())

  session RestockSession @relation(fields: [sessionId], references: [id])
  product Product        @relation(fields: [productId], references: [id])

  @@index([sessionId])
  @@index([productId])
  @@map("restock_items")
}
