model User {
  id           String   @id @default(uuid())
  shopId       String?
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role
  photoUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop         Shop?         @relation(fields: [shopId], references: [id])
  activityLogs ActivityLog[]

  @@index([shopId])
  @@map("users")
}
