NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@localhost:5432/kaarbaar

# Generate a real value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
BCRYPT_SALT_ROUNDS=10

FRONTEND_URL=http://localhost:3000

# Gmail SMTP - SMTP_PASS is an app password, not the account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-shop@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="Kaarbaar <your-shop@gmail.com>"

# Optional
REDIS_URL=