model Vendor {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  phone     String
  due       Decimal   @default(0) @db.Decimal(12, 2)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop            Shop             @relation(fields: [shopId], references: [id])
  restockSessions RestockSession[]

  @@index([shopId, name])
  @@map("vendors")
}
